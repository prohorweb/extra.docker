# Copy to .env in the **repository root** (compose reads ../.env).
#
# Required on production — replace every change-me value.

# --- WordPress database (single DB for multisite) ---
WORDPRESS_DB_NAME=extra
WORDPRESS_DB_USER=extra
WORDPRESS_DB_PASSWORD=change-me-db
MARIADB_ROOT_PASSWORD=change-me-root

# --- Multisite domains ---
# Production (Timeweb):
# WORDPRESS_DOMAIN_CURRENT_SITE=extrasport.ru
# WORDPRESS_COOKIE_DOMAIN=.extrasport.ru
#
# Local dev:
WORDPRESS_DOMAIN_CURRENT_SITE=extrasport.local
WORDPRESS_COOKIE_DOMAIN=.local

WORDPRESS_DEBUG=false

# Post-deploy health-check hostnames (production):
# HEALTHCHECK_HOST_MAIN=extrasport.ru
# HEALTHCHECK_HOST_SECOND=de-vision.ru
# Production: copy deploy/nginx.production.conf.example → nginx.conf
# or set absolute path on the server:
# NGINX_CONF_PATH=/opt/extra.docker/nginx.conf
#
# Let's Encrypt on host (example):
# NGINX_SSL_DIR=/etc/letsencrypt/live/extrasport.ru
#
# CI/CD database import (optional — GitHub Secrets or server .env):
# DATABASE_DUMP_URL=https://github.com/org/repo/releases/download/db-v1/wordpress-extra.sql.gz
# DATABASE_DUMP_TOKEN=ghp_...   # private release; omit for public URL
#
# Domain migration after import (.local → staging/production):
# MIGRATE_FROM_MAIN=extrasport.local
# MIGRATE_FROM_SECOND=devision.local
# MIGRATE_URLS=1   # wp search-replace across all tables (default: 1 on import)
