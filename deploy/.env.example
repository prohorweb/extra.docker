# Copy to ../.env in repo root
#
# WordPress (deploy) — one database only:
WORDPRESS_DB_NAME=extra
WORDPRESS_DB_USER=extra
WORDPRESS_DB_PASSWORD=extra123
WORDPRESS_DOMAIN_CURRENT_SITE=extrasport.local
WORDPRESS_COOKIE_DOMAIN=.local
WORDPRESS_DEBUG=false

# Legacy (dev compose only) uses separate MariaDB (legacy_mariadb):
#   extra      — Yii2
#   extra_new  — Laravel
# Dumps: legacy/db/
