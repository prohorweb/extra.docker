# Production nginx template (copy to repo root as nginx.conf on the server).
#
# SSL: mount Let's Encrypt certs via NGINX_SSL_DIR in .env, e.g.
#   /etc/letsencrypt/live/extrasport.ru/fullchain.pem → docker/nginx/ssl/cert.pem
#   /etc/letsencrypt/live/extrasport.ru/privkey.pem   → docker/nginx/ssl/key.pem
# Or bind-mount the live directory:
#   NGINX_SSL_DIR=/etc/letsencrypt/live/extrasport.ru
# and symlinks/fullchain naming per certbot layout (adjust paths below).

server {
    listen 80;
    server_name extrasport.ru www.extrasport.ru de-vision.ru www.de-vision.ru;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name extrasport.ru www.extrasport.ru de-vision.ru www.de-vision.ru;
    client_max_body_size 64M;

    ssl_certificate     /etc/nginx/ssl/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    root /var/www/wordpress;
    index index.php;

    location ~ ^/(es|dv)/command/?$ {
        return 301 /trainers/$is_args$args;
    }

    location / {
        try_files $uri $uri/ /index.php?$args;
    }

    location ~ \.php$ {
        fastcgi_pass extra_wordpress:9000;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /var/www/html$fastcgi_script_name;
        fastcgi_param HTTP_HOST $http_host;
        fastcgi_param HTTPS on;
    }

    location ~ /\.(ht|git) {
        deny all;
    }

    access_log /var/log/nginx/access.log;
    error_log /var/log/nginx/error.log;
}
